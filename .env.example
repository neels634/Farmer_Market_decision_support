# NetBhav needs NO environment variables to run — the demo uses local data only.
# These placeholders document what a future, verified integration would need.
# Never commit real values; server-only keys must not use the NEXT_PUBLIC_ prefix.

# AGMARKNET / data.gov.in API key (not used yet; access and licensing unverified)
# AGMARKNET_API_KEY=your-key-here

# e-NAM integration credentials (not used yet; requires official access)
# ENAM_CLIENT_ID=your-client-id
# ENAM_CLIENT_SECRET=your-client-secret

# Routing / distance service (not used yet; distances are estimated locally)
# ROUTING_API_KEY=your-key-here
